    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "id": 103,
      "title": "🗄️ Database Connection Pools (HikariCP)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "id": 10,
      "targets": [
        {
          "expr": "hikaricp_connections_active{service=~\"scarlet-auth|scarlet-user\"}",
          "legendFormat": "{{service}} active",
          "refId": "A"
        },
        {
          "expr": "hikaricp_connections_idle{service=~\"scarlet-auth|scarlet-user\"}",
          "legendFormat": "{{service}} idle",
          "refId": "B"
        },
        {
          "expr": "hikaricp_connections_max{service=~\"scarlet-auth|scarlet-user\"}",
          "legendFormat": "{{service}} max",
          "refId": "C"
        }
      ],
      "title": "HikariCP Connection Pool",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "ms" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "id": 11,
      "targets": [
        {
          "expr": "hikaricp_connections_acquire_seconds_sum{service=~\"scarlet-auth|scarlet-user\"} / hikaricp_connections_acquire_seconds_count{service=~\"scarlet-auth|scarlet-user\"}",
          "legendFormat": "{{service}} avg acquire time",
          "refId": "A"
        }
      ],
      "title": "HikariCP Avg Acquire Time",
      "type": "timeseries"
    }
