      "fieldConfig": { "defaults": { "color": { "fixedColor": "red", "mode": "fixed" }, "unit": "percentunit" } },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 19 },
      "id": 8,
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{service=\"scarlet-gateway\",outcome=\"SERVER_ERROR\"}[2m])) / sum(rate(http_server_requests_seconds_count{service=\"scarlet-gateway\"}[2m]))",
          "legendFormat": "Error Rate",
          "refId": "A"
        }
      ],
      "title": "Error Rate (gateway)",
