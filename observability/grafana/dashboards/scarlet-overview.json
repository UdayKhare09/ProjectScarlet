      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 19 },
      "id": 9,
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{service=\"scarlet-gateway\"}[2m])) by (le, uri))",
          "legendFormat": "p99 {{uri}}",
          "refId": "A"
