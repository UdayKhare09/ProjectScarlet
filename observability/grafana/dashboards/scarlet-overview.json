      "id": 6,
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{service=\"scarlet-user\"}[2m])) by (le, uri))",
          "legendFormat": "p99 {{uri}}",
          "refId": "A"
        }
